{
  "name": "dsh-web-sub",
  "version": "0.6.0",
  "description": "Seamlessly bind your DeepSeek and Gemini web sessions to DeepSeek Harness (DSH). Features local OpenAI-compatible bridge, one-click browser login, and native visual QC audit engine for automated motion graphics verification.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "deepseek",
    "gemini",
    "web-chat",
    "subscription",
    "plugin",
    "openai-compatible",
    "visual-qc",
    "motion-graphics",
    "watch-skill"
  ],
  "author": "Vity",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-web-sub": "./bin/dsh-web-sub.mjs"
  },
  "files": [
    "lib",
    "bin",
    "assets",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "selftest": "node tests/selftest.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "react": "^18.0.0"
  }
}
