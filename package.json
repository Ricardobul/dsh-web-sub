{
  "name": "dsh-web-sub",
  "version": "0.8.0",
  "description": "Local OpenAI-compatible bridge & plugin connecting your Gemini, ChatGPT, and DeepSeek web subscriptions to OpenCode Desktop, DeepSeek Harness (DSH), Claude Code, Cline, Cursor, and Continue. Enjoy zero-token-cost development, resilient JSON tool call repair, PKCE OAuth for ChatGPT, and deep reasoning models for software engineering.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "chatgpt",
    "openai-codex",
    "deepseek",
    "gemini",
    "web-chat",
    "subscription",
    "plugin",
    "openai-compatible",
    "opencode",
    "coding-agent",
    "developer-tools",
    "software-engineering",
    "pair-programming"
  ],
  "author": "Vity",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-web-sub": "./bin/dsh-web-sub.mjs"
  },
  "files": [
    "lib",
    "bin",
    "assets",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "selftest": "node tests/selftest.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "react": "^18.0.0"
  }
}
